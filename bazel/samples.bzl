"""Sample packs as Bazel dependencies. See docs/sample-format-plan.md.

    samples      module extension. Reads the pack manifests listed in
                 MODULE.bazel (`samples.pack(manifest = ...)`) and declares
                 one hash-pinned `http_file` per one-shot, plus the visible
                 `@samples` repository, where a sample's label is
                 `@samples//<pack id>:<sample id>`. Files are downloaded only
                 when something depends on them.
    sample       one sample with its id and licence (SampleInfo). The
                 `@samples` targets are these; nothing else declares them.
    sample_kit   a drum kit: General MIDI keys to samples, with touch
                 variants and key aliases (SampleKitInfo, and kit.json for
                 the style bundle).
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

SampleInfo = provider(
    doc = "One sample from a pack.",
    fields = {
        "id": "`<pack id>:<sample id>`, as in the label.",
        "file": "File: the downloaded sample.",
        "path": "Where the site serves it: `<pack id>/<sample id>.<ext>`.",
        "licence": "SPDX id (or LicenseRef-) of the pack.",
    },
)

SampleKitInfo = provider(
    doc = "A drum kit built from samples.",
    fields = {
        "json": "File: the kit as the style bundle carries it (hits by GM key, aliases).",
        "samples": "dict: served path -> File, for every sample the kit names.",
        "licences": "Sorted list of the licences of the packs the kit uses.",
    },
)

# --- The extension ------------------------------------------------------------

def _repo_name(pack_id, sample_id):
    # Pack ids are <source>/<pack> and sample ids [a-z0-9_-]; both are validated by //src/corpus:pack.ts.
    return "samples__%s__%s" % (pack_id.replace("/", "__"), sample_id)

def _ext(file):
    return file[file.rfind("."):]

def _hub_impl(rctx):
    packs = json.decode(rctx.attr.packs)
    rctx.file("BUILD.bazel", "# Sample packs: @samples//<pack id>:<sample id>. Generated by //bazel:samples.bzl.\n")
    for pack_id, pack in packs.items():
        lines = [
            "# %s. Generated by //bazel:samples.bzl from samples/%s/pack.json." % (pack["description"], pack_id),
            'load("@mindless_midi//bazel:samples.bzl", "sample")',
            "",
            'package(default_visibility = ["//visibility:public"])',
            "",
        ]
        for sample_id in sorted(pack["samples"]):
            lines.append('sample(name = "%s", file = "@%s//file", id = "%s:%s", path = "%s/%s%s", licence = "%s")' % (
                sample_id,
                _repo_name(pack_id, sample_id),
                pack_id,
                sample_id,
                pack_id,
                sample_id,
                _ext(pack["samples"][sample_id]),
                pack["licence"],
            ))
        rctx.file(pack_id + "/BUILD.bazel", "\n".join(lines) + "\n")

_hub = repository_rule(
    implementation = _hub_impl,
    attrs = {"packs": attr.string(doc = "JSON: pack id -> {description, licence, samples: {id: file}}.")},
)

def _samples_impl(mctx):
    packs = {}
    for mod in mctx.modules:
        for tag in mod.tags.pack:
            m = json.decode(mctx.read(mctx.path(tag.manifest)))
            if m["kind"] != "oneshots":
                fail("%s: only oneshots packs are supported so far" % tag.manifest)
            if m["id"] in packs:
                fail("pack %s is listed twice" % m["id"])
            files = {}
            for sample_id, s in m["samples"].items():
                http_file(
                    name = _repo_name(m["id"], sample_id),
                    url = s["url"],
                    sha256 = s["sha256"],
                    downloaded_file_path = sample_id + _ext(s["file"]),
                )
                files[sample_id] = s["file"]
            packs[m["id"]] = {"description": m["description"], "licence": m["licence"]["spdx"], "samples": files}
    _hub(name = "samples", packs = json.encode(packs))
    return mctx.extension_metadata(reproducible = True, root_module_direct_deps = ["samples"], root_module_direct_dev_deps = [])

samples = module_extension(
    implementation = _samples_impl,
    doc = "Hash-pinned sample downloads and the @samples labels, from checked-in pack manifests.",
    tag_classes = {
        "pack": tag_class(attrs = {"manifest": attr.label(mandatory = True, doc = "A pack.json under //samples.")}),
    },
)

# --- Rules --------------------------------------------------------------------

def _sample_impl(ctx):
    return [
        DefaultInfo(files = depset([ctx.file.file])),
        SampleInfo(id = ctx.attr.id, file = ctx.file.file, path = ctx.attr.path, licence = ctx.attr.licence),
    ]

sample = rule(
    implementation = _sample_impl,
    doc = "One sample of a pack. Declared in @samples by the extension.",
    attrs = {
        "file": attr.label(allow_single_file = True, mandatory = True),
        "id": attr.string(mandatory = True),
        "path": attr.string(mandatory = True),
        "licence": attr.string(mandatory = True),
    },
    provides = [SampleInfo],
)

VARIANTS = ["default", "hard", "soft"]

# Keys played as another key when the kit has no hit of their own (the
# acoustic kick as the kick, the electric snare as the snare, ...).
GM_ALIASES = {35: 36, 40: 38, 44: 42, 57: 49, 59: 51, 47: 45, 48: 50}

def _sample_kit_impl(ctx):
    hits = {}
    samples = {}
    licences = {}
    for slot, target in ctx.attr.slots.items():
        key, variant = slot.split(".")
        info = target[SampleInfo]
        hits.setdefault(key, {})[variant] = {"id": info.id, "path": info.path}
        samples[info.path] = info.file
        licences[info.licence] = True
    for key, variants in hits.items():
        if "default" not in variants:
            fail("key %s has %s but no default" % (key, ", ".join(sorted(variants))))
    aliases = {}
    for key, to in ctx.attr.aliases.items():
        if key in hits:
            continue  # The kit's own hit wins over the alias.
        if to not in hits:
            fail("alias %s -> %s: the kit has no key %s" % (key, to, to))
        aliases[key] = int(to)
    out = ctx.actions.declare_file(ctx.label.name + ".kit.json")
    ctx.actions.write(out, json.encode({"hits": hits, "aliases": aliases}))
    return [
        DefaultInfo(files = depset([out] + samples.values())),
        SampleKitInfo(json = out, samples = samples, licences = sorted(licences.keys())),
    ]

_sample_kit = rule(
    implementation = _sample_kit_impl,
    attrs = {
        "slots": attr.string_keyed_label_dict(providers = [SampleInfo], mandatory = True, doc = "`<key>.<variant>` -> sample."),
        "aliases": attr.string_dict(doc = "key -> key it is played as."),
    },
    provides = [SampleKitInfo],
)

def sample_kit(name, hits, aliases = GM_ALIASES, **kwargs):
    """A drum kit for a style: General MIDI percussion keys to samples.

    Args:
      name: target name; pass it to `music_style(kit = ...)`.
      hits: key -> a sample label, or {"default": label, "hard": label, "soft": label}
        where "hard" and "soft" are optional: with touch, a hard hit plays the
        hard recording and a light one the soft recording.
      aliases: key -> key it is played as, for keys the kit has no hit of its own.
      **kwargs: passed to the rule.
    """
    slots = {}
    for key, hit in hits.items():
        variants = hit if type(hit) == "dict" else {"default": hit}
        for variant, label in variants.items():
            if variant not in VARIANTS:
                fail("key %s: unknown variant %s (expected one of %s)" % (key, variant, ", ".join(VARIANTS)))
            slots["%s.%s" % (key, variant)] = label
    _sample_kit(
        name = name,
        slots = slots,
        aliases = {str(k): str(v) for k, v in aliases.items()},
        **kwargs
    )
