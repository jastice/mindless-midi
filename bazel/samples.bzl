"""Sample packs as Bazel dependencies. See docs/sample-format-plan.md.

    samples      module extension. Reads the program table
                 (`samples.table(file = ...)`, samples/instruments.json) and
                 the manifest of every pack it names, plus the packs listed
                 in MODULE.bazel (`samples.pack(manifest = ...)`). Declares
                 one hash-pinned `http_file` per one-shot, one repository per
                 multisampled instrument that downloads all its files at
                 once (each checked against its hash), and the visible
                 `@samples` repository: a sample's label is
                 `@samples//<pack id>:<sample id>`, a whole pack's
                 `@samples//<pack id>`. Files are downloaded only when
                 something depends on them.
    sample       one sample with its id and licence (SampleInfo). The
                 `@samples` targets are these; nothing else declares them.
    sample_pack  a whole pack: its manifest and every file (SamplePackInfo).
                 What a style declares in `music_style(packs = ...)`.
    sample_sources  the upstream documents multisample packs were generated
                 from, at `<name>/<pack id>/<file>`, for the zone test.
    sample_kit   a drum kit: General MIDI keys to samples, with touch
                 variants and key aliases (SampleKitInfo, and kit.json for
                 the style bundle).
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

SampleInfo = provider(
    doc = "One sample from a pack.",
    fields = {
        "id": "`<pack id>:<sample id>`, as in the label.",
        "file": "File: the downloaded sample.",
        "path": "Where the site serves it: `<pack id>/<sample id>.<ext>`.",
        "licence": "SPDX id (or LicenseRef-) of the pack.",
    },
)

SamplePackInfo = provider(
    doc = "A whole pack.",
    fields = {
        "id": "Pack id, `<source>/<pack>`.",
        "manifest": "File: its pack.json.",
        "files": "dict: served path (`<pack id>/<sample id>.<ext>`) -> File, for every sample.",
        "licence": "SPDX id (or LicenseRef-) of the pack.",
        "source": "File or None: for a multisample, the upstream document it was generated from.",
    },
)

SampleKitInfo = provider(
    doc = "A drum kit built from samples.",
    fields = {
        "json": "File: the kit as the style bundle carries it (hits by GM key, aliases).",
        "samples": "dict: served path -> File, for every sample the kit names.",
        "licences": "Sorted list of the licences of the packs the kit uses.",
    },
)

# --- The extension ------------------------------------------------------------

def _repo_name(pack_id, sample_id):
    # Pack ids are <source>/<pack> and sample ids [a-z0-9_-]; both are validated by //src/corpus:pack.ts.
    return "samples__%s__%s" % (pack_id.replace("/", "__"), sample_id)

def _ext(file):
    return file[file.rfind("."):]

def _group_name(pack_id):
    return "samples__%s" % pack_id.replace("/", "__")

def _source_name(pack_id):
    return "samples_source__%s" % pack_id.replace("/", "__")

def _basename(pack_id):
    return pack_id.split("/")[1]

def _hub_impl(rctx):
    packs = json.decode(rctx.attr.packs)
    multisamples = sorted([p for p, pack in packs.items() if pack["kind"] == "multisample"])
    rctx.file("BUILD.bazel", "# Sample packs: @samples//<pack id>:<sample id>. Generated by //bazel:samples.bzl.\n")
    rctx.file("packs.bzl", "# Generated by //bazel:samples.bzl.\nPACKS = %s\nMULTISAMPLE_PACKS = %s\n" % (json.encode(sorted(packs.keys())), json.encode(multisamples)))
    for pack_id, pack in packs.items():
        name = _basename(pack_id)
        lines = [
            "# %s. Generated by //bazel:samples.bzl from samples/%s/pack.json." % (pack["description"], pack_id),
            'load("@mindless_midi//bazel:samples.bzl", "sample", "sample_pack")',
            "",
            'package(default_visibility = ["//visibility:public"])',
            "",
        ]
        if name in pack["samples"] or "source" in pack["samples"]:
            fail("pack %s: a sample is named like the pack or `source`" % pack_id)
        manifest = "@mindless_midi//samples:%s/pack.json" % pack_id
        if pack["kind"] == "oneshots":
            for sample_id in sorted(pack["samples"]):
                lines.append('sample(name = "%s", file = "@%s//file", id = "%s:%s", path = "%s/%s%s", licence = "%s")' % (
                    sample_id,
                    _repo_name(pack_id, sample_id),
                    pack_id,
                    sample_id,
                    pack_id,
                    sample_id,
                    _ext(pack["samples"][sample_id]),
                    pack["licence"],
                ))
            lines.append('sample_pack(name = "%s", id = "%s", manifest = "%s", srcs = [%s], licence = "%s")' % (
                name,
                pack_id,
                manifest,
                ", ".join(['":%s"' % s for s in sorted(pack["samples"])]),
                pack["licence"],
            ))
        else:
            lines.append('alias(name = "source", actual = "@%s//file")' % _source_name(pack_id))
            lines.append('sample_pack(name = "%s", id = "%s", manifest = "%s", srcs = ["@%s//:files"], source = ":source", licence = "%s")' % (
                name,
                pack_id,
                manifest,
                _group_name(pack_id),
                pack["licence"],
            ))
        rctx.file(pack_id + "/BUILD.bazel", "\n".join(lines) + "\n")

_hub = repository_rule(
    implementation = _hub_impl,
    attrs = {"packs": attr.string(doc = "JSON: pack id -> {kind, description, licence, samples: {id: file}}.")},
)

def _group_impl(rctx):
    files = json.decode(rctx.attr.files)
    # Started together, then waited on: one repository, many concurrent downloads, each hash-checked.
    pending = [
        rctx.download(url = f["url"], output = name, sha256 = f["sha256"], block = False)
        for name, f in sorted(files.items())
    ]
    for p in pending:
        p.wait()
    rctx.file("BUILD.bazel", "\n".join([
        "# %s. Generated by //bazel:samples.bzl." % rctx.attr.pack,
        'filegroup(name = "files", srcs = %s, visibility = ["//visibility:public"])' % json.encode(sorted(files.keys())),
        "",
    ]))

_group = repository_rule(
    implementation = _group_impl,
    doc = "Every file of one multisampled instrument, named `<sample id>.<ext>`.",
    attrs = {
        "pack": attr.string(mandatory = True),
        "files": attr.string(mandatory = True, doc = "JSON: file name -> {url, sha256}."),
    },
)

def _samples_impl(mctx):
    manifests = []
    for mod in mctx.modules:
        for tag in mod.tags.table:
            table = json.decode(mctx.read(mctx.path(tag.file)))
            ids = {}
            for entry in table["programs"].values():
                for pack_id in entry["packs"].values():
                    ids[pack_id] = True
            for pack_id in sorted(ids):
                manifests.append(Label("//samples:%s/pack.json" % pack_id))
        for tag in mod.tags.pack:
            manifests.append(tag.manifest)
    packs = {}
    for manifest in manifests:
        m = json.decode(mctx.read(mctx.path(manifest)))
        if m["id"] in packs:
            fail("pack %s is listed twice (MODULE.bazel lists a pack the table already names?)" % m["id"])
        files = {}
        if m["kind"] == "oneshots":
            for sample_id, s in m["samples"].items():
                http_file(
                    name = _repo_name(m["id"], sample_id),
                    url = s["url"],
                    sha256 = s["sha256"],
                    downloaded_file_path = sample_id + _ext(s["file"]),
                )
                files[sample_id] = s["file"]
        elif m["kind"] == "multisample":
            group = {}
            for sample_id, s in m["samples"].items():
                group[sample_id + _ext(s["file"])] = {"url": s["url"], "sha256": s["sha256"]}
                files[sample_id] = s["file"]
            _group(name = _group_name(m["id"]), pack = m["id"], files = json.encode(group))
            src = m["source"]
            http_file(
                name = _source_name(m["id"]),
                url = src["url"],
                sha256 = src["sha256"],
                downloaded_file_path = src["path"].split("/")[-1],
            )
        else:
            fail("%s: unknown kind %s" % (manifest, m["kind"]))
        packs[m["id"]] = {"kind": m["kind"], "description": m["description"], "licence": m["licence"]["spdx"], "samples": files}
    _hub(name = "samples", packs = json.encode(packs))
    return mctx.extension_metadata(reproducible = True, root_module_direct_deps = ["samples"], root_module_direct_dev_deps = [])

samples = module_extension(
    implementation = _samples_impl,
    doc = "Hash-pinned sample downloads and the @samples labels, from checked-in pack manifests.",
    tag_classes = {
        "table": tag_class(attrs = {"file": attr.label(mandatory = True, doc = "samples/instruments.json: every pack it names is loaded.")}),
        "pack": tag_class(attrs = {"manifest": attr.label(mandatory = True, doc = "A pack.json under //samples the table does not name.")}),
    },
)

# --- Rules --------------------------------------------------------------------

def _sample_impl(ctx):
    return [
        DefaultInfo(files = depset([ctx.file.file])),
        SampleInfo(id = ctx.attr.id, file = ctx.file.file, path = ctx.attr.path, licence = ctx.attr.licence),
    ]

sample = rule(
    implementation = _sample_impl,
    doc = "One sample of a pack. Declared in @samples by the extension.",
    attrs = {
        "file": attr.label(allow_single_file = True, mandatory = True),
        "id": attr.string(mandatory = True),
        "path": attr.string(mandatory = True),
        "licence": attr.string(mandatory = True),
    },
    provides = [SampleInfo],
)

def _sample_pack_impl(ctx):
    files = {}
    for target in ctx.attr.srcs:
        if SampleInfo in target:
            info = target[SampleInfo]
            files[info.path] = info.file
        else:
            for f in target[DefaultInfo].files.to_list():
                files["%s/%s" % (ctx.attr.id, f.basename)] = f
    source = ctx.file.source
    return [
        DefaultInfo(files = depset([ctx.file.manifest] + files.values())),
        SamplePackInfo(id = ctx.attr.id, manifest = ctx.file.manifest, files = files, licence = ctx.attr.licence, source = source),
    ]

sample_pack = rule(
    implementation = _sample_pack_impl,
    doc = "A whole pack. Declared in @samples by the extension: @samples//<pack id>.",
    attrs = {
        "id": attr.string(mandatory = True),
        "manifest": attr.label(allow_single_file = True, mandatory = True),
        "srcs": attr.label_list(allow_files = True, doc = "The pack's `sample` targets, or a group repository's files."),
        "source": attr.label(allow_single_file = True),
        "licence": attr.string(mandatory = True),
    },
    provides = [SamplePackInfo],
)

def _sample_sources_impl(ctx):
    outs = []
    for target in ctx.attr.packs:
        info = target[SamplePackInfo]
        if not info.source:
            continue
        out = ctx.actions.declare_file("%s/%s/%s" % (ctx.label.name, info.id, info.source.basename))
        ctx.actions.symlink(output = out, target_file = info.source)
        outs.append(out)
    return [DefaultInfo(files = depset(outs), runfiles = ctx.runfiles(files = outs))]

sample_sources = rule(
    implementation = _sample_sources_impl,
    doc = "The upstream documents multisample packs were generated from, at <name>/<pack id>/<file>.",
    attrs = {"packs": attr.label_list(providers = [SamplePackInfo])},
)

VARIANTS = ["default", "hard", "soft"]

# Keys played as another key when the kit has no hit of their own (the
# acoustic kick as the kick, the electric snare as the snare, ...).
GM_ALIASES = {35: 36, 40: 38, 44: 42, 57: 49, 59: 51, 47: 45, 48: 50}

def _sample_kit_impl(ctx):
    hits = {}
    samples = {}
    licences = {}
    for slot, target in ctx.attr.slots.items():
        key, variant = slot.split(".")
        info = target[SampleInfo]
        hits.setdefault(key, {})[variant] = {"id": info.id, "path": info.path}
        samples[info.path] = info.file
        licences[info.licence] = True
    for key, variants in hits.items():
        if "default" not in variants:
            fail("key %s has %s but no default" % (key, ", ".join(sorted(variants))))
    aliases = {}
    for key, to in ctx.attr.aliases.items():
        if key in hits:
            continue  # The kit's own hit wins over the alias.
        if to not in hits:
            fail("alias %s -> %s: the kit has no key %s" % (key, to, to))
        aliases[key] = int(to)
    out = ctx.actions.declare_file(ctx.label.name + ".kit.json")
    ctx.actions.write(out, json.encode({"hits": hits, "aliases": aliases}))
    return [
        DefaultInfo(files = depset([out] + samples.values())),
        SampleKitInfo(json = out, samples = samples, licences = sorted(licences.keys())),
    ]

_sample_kit = rule(
    implementation = _sample_kit_impl,
    attrs = {
        "slots": attr.string_keyed_label_dict(providers = [SampleInfo], mandatory = True, doc = "`<key>.<variant>` -> sample."),
        "aliases": attr.string_dict(doc = "key -> key it is played as."),
    },
    provides = [SampleKitInfo],
)

def sample_kit(name, hits, aliases = GM_ALIASES, **kwargs):
    """A drum kit for a style: General MIDI percussion keys to samples.

    Args:
      name: target name; pass it to `music_style(kit = ...)`.
      hits: key -> a sample label, or {"default": label, "hard": label, "soft": label}
        where "hard" and "soft" are optional: with touch, a hard hit plays the
        hard recording and a light one the soft recording.
      aliases: key -> key it is played as, for keys the kit has no hit of its own.
      **kwargs: passed to the rule.
    """
    slots = {}
    for key, hit in hits.items():
        variants = hit if type(hit) == "dict" else {"default": hit}
        for variant, label in variants.items():
            if variant not in VARIANTS:
                fail("key %s: unknown variant %s (expected one of %s)" % (key, variant, ", ".join(VARIANTS)))
            slots["%s.%s" % (key, variant)] = label
    _sample_kit(
        name = name,
        slots = slots,
        aliases = {str(k): str(v) for k, v in aliases.items()},
        **kwargs
    )
