load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")

music_style(
    name = "style",
    bank = 1,
    brief = "brief.md",
    color = "#38a169",
    corpus = "corpus.json",
    packs = [
        "@samples//danigb-samples/dsmolken-double-bass-pizz",
        "@samples//danigb-samples/lm-2",
        "@samples//danigb-samples/sample-pi-drums",
        "@samples//danigb-samples/tr-808",
        "@samples//gleitz-musyngkite/accordion",
        "@samples//gleitz-musyngkite/acoustic-guitar-steel",
        "@samples//gleitz-musyngkite/bagpipe",
        "@samples//gleitz-musyngkite/banjo",
        "@samples//gleitz-musyngkite/choir-aahs",
        "@samples//gleitz-musyngkite/flute",
        "@samples//gleitz-musyngkite/orchestral-harp",
        "@samples//gleitz-musyngkite/piccolo",
        "@samples//gleitz-musyngkite/violin",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
