load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")
load("//bazel:samples.bzl", "sample_kit")

# The LinnDrum kit (as synthwave's). No pattern uses drums; only the ending's
# kick, crash and low tom can play.
sample_kit(
    name = "kit",
    hits = {
        "36": "@samples//danigb-samples/lm-2:kick",
        "38": "@samples//danigb-samples/lm-2:snare-m",
        "37": "@samples//danigb-samples/lm-2:stick-m",
        "39": "@samples//danigb-samples/lm-2:clap",
        "42": "@samples//danigb-samples/lm-2:hhclosed",
        "46": "@samples//danigb-samples/lm-2:hhopen",
        "51": "@samples//danigb-samples/lm-2:ride",
        "49": "@samples//danigb-samples/lm-2:crash",
        "45": "@samples//danigb-samples/lm-2:tom-l",
        "50": "@samples//danigb-samples/lm-2:tom-h",
        "70": "@samples//danigb-samples/lm-2:cabasa",
    },
)

music_style(
    name = "style",
    bank = 72,
    brief = "brief.md",
    color = "#90cdf4",
    corpus = "corpus.json",
    kit = ":kit",
    packs = [
        "@samples//danigb-samples/splendid-grand-piano",
        "@samples//danigb-samples/vcsl-marimba",
        "@samples//gleitz-musyngkite/string-ensemble-2",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
