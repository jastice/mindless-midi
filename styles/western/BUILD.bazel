load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")

music_style(
    name = "style",
    bank = 68,
    brief = "brief.md",
    color = "#b7791f",
    corpus = "corpus.json",
    packs = [
        "@samples//danigb-samples/dsmolken-double-bass-pizz",
        "@samples//danigb-samples/lm-2",
        "@samples//danigb-samples/sample-pi-drums",
        "@samples//danigb-samples/splendid-grand-piano",
        "@samples//danigb-samples/tr-808",
        "@samples//gleitz-musyngkite/acoustic-guitar-nylon",
        "@samples//gleitz-musyngkite/acoustic-guitar-steel",
        "@samples//gleitz-musyngkite/choir-aahs",
        "@samples//gleitz-musyngkite/electric-bass-pick",
        "@samples//gleitz-musyngkite/electric-guitar-clean",
        "@samples//gleitz-musyngkite/harmonica",
        "@samples//gleitz-musyngkite/string-ensemble-1",
        "@samples//gleitz-musyngkite/tremolo-strings",
        "@samples//gleitz-musyngkite/trumpet",
        "@samples//gleitz-musyngkite/tubular-bells",
        "@samples//gleitz-musyngkite/violin",
        "@samples//gleitz-musyngkite/voice-oohs",
        "@samples//gleitz-musyngkite/whistle",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
