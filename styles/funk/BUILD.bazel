load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")

music_style(
    name = "style",
    bank = 72,
    brief = "brief.md",
    color = "#dd6b20",
    corpus = "corpus.json",
    packs = [
        "@samples//danigb-samples/lm-2",
        "@samples//danigb-samples/sample-pi-drums",
        "@samples//danigb-samples/vcsl-tenor-saxophone-vibrato",
        "@samples//danigb-samples/wurlitzer-ep200",
        "@samples//gleitz-musyngkite/brass-section",
        "@samples//gleitz-musyngkite/clavinet",
        "@samples//gleitz-musyngkite/electric-bass-finger",
        "@samples//gleitz-musyngkite/electric-guitar-clean",
        "@samples//gleitz-musyngkite/electric-guitar-muted",
        "@samples//gleitz-musyngkite/flute",
        "@samples//gleitz-musyngkite/harmonica",
        "@samples//gleitz-musyngkite/lead-2-sawtooth",
        "@samples//gleitz-musyngkite/slap-bass-1",
        "@samples//gleitz-musyngkite/string-ensemble-1",
        "@samples//gleitz-musyngkite/synth-bass-2",
        "@samples//gleitz-musyngkite/synth-choir",
        "@samples//gleitz-musyngkite/synth-strings-1",
        "@samples//gleitz-musyngkite/trumpet",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
