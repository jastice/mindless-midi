load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")
load("//bazel:samples.bzl", "sample_kit")

sample_kit(
    name = "kit",
    hits = {
        "36": "@samples//danigb-samples/sample-pi-drums:drum_heavy_kick",
        "38": {"default": "@samples//danigb-samples/sample-pi-drums:drum_snare_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_snare_soft"},
        "37": "@samples//danigb-samples/lm-2:stick-h",
        "39": "@samples//danigb-samples/lm-2:clap",
        "42": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_closed",
        "46": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_open",
        "51": "@samples//danigb-samples/lm-2:ride",
        "49": {"default": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_soft"},
        "45": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_soft"},
        "50": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_soft"},
        "70": "@samples//danigb-samples/lm-2:cabasa",
    },
)

music_style(
    name = "style",
    bank = 68,
    brief = "brief.md",
    color = "#c53030",
    corpus = "corpus.json",
    kit = ":kit",
    packs = [
        "@samples//gleitz-musyngkite/choir-aahs",
        "@samples//gleitz-musyngkite/church-organ",
        "@samples//gleitz-musyngkite/distortion-guitar",
        "@samples//gleitz-musyngkite/electric-bass-pick",
        "@samples//gleitz-musyngkite/harpsichord",
        "@samples//gleitz-musyngkite/music-box",
        "@samples//gleitz-musyngkite/overdriven-guitar",
        "@samples//gleitz-musyngkite/pan-flute",
        "@samples//gleitz-musyngkite/tubular-bells",
        "@samples//gleitz-musyngkite/violin",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
