load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")
load("//bazel:samples.bzl", "sample_kit")

sample_kit(
    name = "kit",
    hits = {
        "36": {"default": "@samples//danigb-samples/sample-pi-drums:drum_bass_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_bass_soft"},
        "38": {"default": "@samples//danigb-samples/sample-pi-drums:drum_snare_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_snare_hard"},
        "37": "@samples//danigb-samples/sample-pi-drums:perc_snap",
        "39": "@samples//danigb-samples/sample-pi-drums:perc_snap2",
        "42": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_closed",
        "46": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_open",
        "51": {"default": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_hard"},
        "49": {"default": "@samples//danigb-samples/sample-pi-drums:drum_splash_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_splash_soft"},
        "45": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_hard"},
        "50": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_hard"},
        "70": "@samples//danigb-samples/lm-2:cabasa",
    },
)

music_style(
    name = "style",
    bank = 72,
    brief = "brief.md",
    color = "#b794f4",
    corpus = "corpus.json",
    kit = ":kit",
    packs = [
        "@samples//danigb-samples/vcsl-vibraphone-soft-mallets",
        "@samples//danigb-samples/wurlitzer-ep200",
        "@samples//gleitz-musyngkite/acoustic-guitar-nylon",
        "@samples//gleitz-musyngkite/electric-bass-finger",
        "@samples//gleitz-musyngkite/pad-2-warm",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
