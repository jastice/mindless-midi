load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//bazel:music.bzl", "style_pack", "style_samples")

STYLES = [
    "metroid",
    "retro",
    "lofi",
    "jazz_trio",
    "minimalist",
    "monkey_island",
    "electro_swing",
    "synthwave",
    "bossa_nova",
    "funk",
    "western",
    "celtic",
    "musette",
    "liquid_dnb",
    "castlevania",
    "jrpg",
    "disco",
    "baroque",
    "orbital_glass",
    "midnight_platform",
    "courtyard_nine",
    "low_log",
]

style_pack(
    name = "styles",
    styles = ["//styles/%s:style" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# The sample files these styles can play, fetched at build time (the declared
# instruments and key ranges decide which). The site serves them as samples/.
# samples.lock.json pins their hashes; bazel run //styles:samples_lock refreshes it.
style_samples(
    name = "samples",
    lock = "samples.lock.json",
    styles = ["//styles/%s:style" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# The pin itself, for tests that check a file is among the ones the site serves.
js_library(
    name = "samples_lock_json",
    srcs = ["samples.lock.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "corpora",
    srcs = ["//styles/%s:corpus" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# DJ Claudia's styles: a pack of their own, so they do not appear in the other
# apps (and the styles above do not appear in hers).
CLAUDIA_STYLES = [
    "minimal_techno",
]

style_pack(
    name = "claudia",
    styles = ["//styles/%s:style" % s for s in CLAUDIA_STYLES],
    visibility = ["//visibility:public"],
)

# claudia_samples.lock.json pins them; bazel run //styles:claudia_samples_lock refreshes it.
style_samples(
    name = "claudia_samples",
    lock = "claudia_samples.lock.json",
    styles = ["//styles/%s:style" % s for s in CLAUDIA_STYLES],
    visibility = ["//visibility:public"],
)

js_library(
    name = "claudia_samples_lock_json",
    srcs = ["claudia_samples.lock.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "claudia_corpora",
    srcs = ["//styles/%s:corpus" % s for s in CLAUDIA_STYLES],
    visibility = ["//visibility:public"],
)

# bazel run //styles:regen -- styles/metroid   (needs Claude API credentials)
alias(
    name = "regen",
    actual = "//tools/generate",
)
