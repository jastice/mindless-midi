load("//bazel:music.bzl", "style_pack")

STYLES = [
    "metroid",
    "retro",
    "lofi",
    "jazz_trio",
    "minimalist",
    "monkey_island",
    "electro_swing",
    "synthwave",
    "bossa_nova",
    "funk",
    "western",
    "celtic",
    "musette",
    "liquid_dnb",
    "castlevania",
    "jrpg",
]

style_pack(
    name = "styles",
    styles = ["//styles/%s:style" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "corpora",
    srcs = ["//styles/%s:corpus" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# bazel run //styles:regen -- styles/metroid   (needs Claude API credentials)
alias(
    name = "regen",
    actual = "//tools/generate",
)
