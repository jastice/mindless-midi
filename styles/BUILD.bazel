load("//bazel:music.bzl", "style_pack", "style_samples")

STYLES = [
    "metroid",
    "retro",
    "lofi",
    "jazz_trio",
    "minimalist",
    "monkey_island",
    "electro_swing",
    "synthwave",
    "bossa_nova",
    "funk",
    "western",
    "celtic",
    "musette",
    "liquid_dnb",
    "castlevania",
    "jrpg",
    "disco",
    "baroque",
    "orbital_glass",
    "midnight_platform",
    "courtyard_nine",
    "low_log",
]

style_pack(
    name = "styles",
    styles = ["//styles/%s:style" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# The sample files these styles can play, packaged offline from the sample
# packs each style declares (its music_style's `packs` and `kit`); the
# declared key ranges decide which files ship. The site serves them as
# samples/. A range that reaches outside a style's packs fails the build.
style_samples(
    name = "samples",
    styles = ["//styles/%s:style" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# Every file the styles' packs hold, for the dev servers and tests.
filegroup(
    name = "samples_superset",
    srcs = [":samples"],
    output_group = "superset",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "corpora",
    srcs = ["//styles/%s:corpus" % s for s in STYLES],
    visibility = ["//visibility:public"],
)

# DJ Claudia's styles: a pack of their own, so they do not appear in the other
# apps (and the styles above do not appear in hers).
CLAUDIA_STYLES = [
    "minimal_techno",
]

style_pack(
    name = "claudia",
    styles = ["//styles/%s:style" % s for s in CLAUDIA_STYLES],
    visibility = ["//visibility:public"],
)

style_samples(
    name = "claudia_samples",
    styles = ["//styles/%s:style" % s for s in CLAUDIA_STYLES],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "claudia_samples_superset",
    srcs = [":claudia_samples"],
    output_group = "superset",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "claudia_corpora",
    srcs = ["//styles/%s:corpus" % s for s in CLAUDIA_STYLES],
    visibility = ["//visibility:public"],
)

# bazel run //styles:regen -- styles/metroid   (needs Claude API credentials)
alias(
    name = "regen",
    actual = "//tools/generate",
)
