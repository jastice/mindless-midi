load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")
load("//bazel:samples.bzl", "sample_kit")

# A TR-808 for the round kick, the clap, the hats and the roll's snare, and
# the LM-2's congas and cabasa for the hand percussion; the crash is the
# 909's, as in the technos.
sample_kit(
    name = "kit",
    hits = {
        "36": {
            "default": "@samples//danigb-samples/tr-808:bd5025",
            "soft": "@samples//danigb-samples/tr-808:bd5010",
        },
        "38": "@samples//danigb-samples/tr-808:sd5050",
        "37": "@samples//danigb-samples/lm-2:conga-hh",
        "39": "@samples//danigb-samples/tr-808:cp",
        "42": "@samples//danigb-samples/tr-808:ch",
        "46": "@samples//danigb-samples/tr-808:oh25",
        "49": "@samples//danigb-sampled/tr909-detroit:cymbal",
        "45": "@samples//danigb-samples/lm-2:conga-l",
        "50": "@samples//danigb-samples/lm-2:conga-h",
        "70": "@samples//danigb-samples/lm-2:cabasa",
    },
)

music_style(
    name = "style",
    bank = 68,
    brief = "brief.md",
    color = "#d98a3d",
    corpus = "corpus.json",
    kit = ":kit",
    packs = [
        "@samples//gleitz-musyngkite/lead-1-square",
        "@samples//gleitz-musyngkite/pad-2-warm",
        "@samples//gleitz-musyngkite/pad-3-polysynth",
        "@samples//gleitz-musyngkite/synth-bass-1",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
