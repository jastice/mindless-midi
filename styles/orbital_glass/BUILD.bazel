load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")

music_style(
    name = "style",
    bank = 68,
    brief = "brief.md",
    color = "#76c9d6",
    corpus = "corpus.json",
    packs = [
        "@samples//danigb-samples/lm-2",
        "@samples//danigb-samples/vcsl-vibraphone-soft-mallets",
        "@samples//gleitz-musyngkite/celesta",
        "@samples//gleitz-musyngkite/fx-3-crystal",
        "@samples//gleitz-musyngkite/music-box",
        "@samples//gleitz-musyngkite/pad-2-warm",
        "@samples//gleitz-musyngkite/synth-bass-1",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
