load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")
load("//bazel:samples.bzl", "sample_kit")

sample_kit(
    name = "kit",
    hits = {
        "36": {"default": "@samples//danigb-samples/sample-pi-drums:drum_bass_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_bass_hard"},
        "38": {"default": "@samples//danigb-samples/sample-pi-drums:drum_snare_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_snare_hard"},
        "37": "@samples//danigb-samples/lm-2:stick-m",
        "39": "@samples//danigb-samples/lm-2:clap",
        "42": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_pedal",
        "46": "@samples//danigb-samples/sample-pi-drums:drum_cymbal_open",
        "51": "@samples//danigb-samples/lm-2:ride",
        "49": {"default": "@samples//danigb-samples/sample-pi-drums:drum_splash_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_splash_hard"},
        "45": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_hard"},
        "50": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_hard"},
        "70": "@samples//danigb-samples/lm-2:cabasa",
    },
)

music_style(
    name = "style",
    bank = 72,
    brief = "brief.md",
    color = "#fc8181",
    corpus = "corpus.json",
    kit = ":kit",
    packs = [
        "@samples//danigb-samples/dsmolken-double-bass-pizz",
        "@samples//danigb-samples/splendid-grand-piano",
        "@samples//danigb-samples/vcsl-tenor-saxophone-vibrato",
        "@samples//danigb-samples/vcsl-vibraphone-soft-mallets",
        "@samples//gleitz-musyngkite/acoustic-guitar-nylon",
        "@samples//gleitz-musyngkite/cello",
        "@samples//gleitz-musyngkite/flute",
        "@samples//gleitz-musyngkite/string-ensemble-1",
        "@samples//gleitz-musyngkite/string-ensemble-2",
        "@samples//gleitz-musyngkite/trumpet",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
