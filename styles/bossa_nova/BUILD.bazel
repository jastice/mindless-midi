load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")

music_style(
    name = "style",
    bank = 72,
    brief = "brief.md",
    color = "#fc8181",
    corpus = "corpus.json",
    packs = [
        "@samples//danigb-samples/dsmolken-double-bass-pizz",
        "@samples//danigb-samples/lm-2",
        "@samples//danigb-samples/sample-pi-drums",
        "@samples//danigb-samples/splendid-grand-piano",
        "@samples//danigb-samples/vcsl-tenor-saxophone-vibrato",
        "@samples//danigb-samples/vcsl-vibraphone-soft-mallets",
        "@samples//gleitz-musyngkite/acoustic-guitar-nylon",
        "@samples//gleitz-musyngkite/cello",
        "@samples//gleitz-musyngkite/flute",
        "@samples//gleitz-musyngkite/string-ensemble-1",
        "@samples//gleitz-musyngkite/string-ensemble-2",
        "@samples//gleitz-musyngkite/trumpet",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
