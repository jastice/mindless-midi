load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//bazel:music.bzl", "music_style")
load("//bazel:samples.bzl", "sample_kit")

# Dum on the kick, tek on the stick, slap on the tom, zills on the cabasa.
sample_kit(
    name = "kit",
    hits = {
        "36": {"default": "@samples//danigb-samples/sample-pi-drums:drum_bass_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_bass_hard"},
        "37": "@samples//danigb-samples/lm-2:stick-h",
        "49": {"default": "@samples//danigb-samples/sample-pi-drums:drum_splash_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_splash_hard"},
        "45": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_hard", "soft": "@samples//danigb-samples/sample-pi-drums:drum_tom_lo_soft"},
        "50": {"default": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_soft", "hard": "@samples//danigb-samples/sample-pi-drums:drum_tom_hi_hard"},
        "70": "@samples//danigb-samples/lm-2:cabasa",
    },
)

music_style(
    name = "style",
    bank = 68,
    brief = "brief.md",
    color = "#c4483a",
    corpus = "corpus.json",
    kit = ":kit",
    packs = [
        "@samples//danigb-samples/dsmolken-double-bass-pizz",
        "@samples//gleitz-musyngkite/acoustic-guitar-steel",
        "@samples//gleitz-musyngkite/oboe",
        "@samples//gleitz-musyngkite/orchestral-harp",
        "@samples//gleitz-musyngkite/string-ensemble-1",
    ],
    visibility = ["//visibility:public"],
)

# For JS tests that read the raw corpus from runfiles.
copy_to_bin(
    name = "corpus",
    srcs = ["corpus.json"],
    visibility = ["//visibility:public"],
)
