load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("//bazel:stamp.bzl", "stamp_build_info")
load("//bazel:ts.bzl", "ts_lib")

# Playback without a page: the scheduler and engines, and the media-key anchor.
# Shared with other front ends (//src/mighty).
ts_lib(
    name = "player",
    srcs = [
        "media_anchor.ts",
        "player.ts",
    ],
    visibility = ["//src:__subpackages__"],
    deps = [
        "//src/audio:events",
        "//src/corpus",
        "//src/engine",
        "//src/sound",
    ],
)

ts_lib(
    name = "app",
    srcs = [
        "app.ts",
        "assets.d.ts",
        "roll.ts",
    ],
    deps = [
        ":player",
        "//:node_modules/libadlmidi-js",
        "//src/audio:events",
        "//src/corpus",
        "//src/engine",
        "//src/sound",
        "//src/theory",
    ],
)

# app.js plus the content-hashed synth .wasm it references.
esbuild(
    name = "bundle",
    config = {
        "assetNames": "[name]-[hash]",
        "entryNames": "[name]",
        "loader": {".wasm": "file"},
        "legalComments": "linked",
    },
    entry_points = [":app.js"],
    format = "esm",
    minify = True,
    output_dir = True,
    sourcemap = "linked",
    target = "es2022",
    visibility = ["//site:__pkg__"],
    deps = [
        ":app",
        "//:node_modules/libadlmidi-js",
    ],
)

# index.html with the footer build line filled in (see --config=stamp).
stamp_build_info(
    name = "index_html",
    src = "index.html",
    out = "stamped/index.html",
    visibility = ["//site:__pkg__"],
)

filegroup(
    name = "fonts",
    srcs = glob(["fonts/*.woff2", "fonts/OFL-*.txt"]),
    visibility = ["//site:__pkg__", "//src/claudia:__pkg__", "//src/mighty:__pkg__"],
)

exports_files(
    [
        "styles.css",
        "favicon.svg",
        "social.png",
    ],
    visibility = ["//site:__pkg__", "//src/bench:__pkg__"],
)
