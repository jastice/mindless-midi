load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("//bazel:ts.bzl", "ts_lib", "ts_test")

# Sound engines beyond the OPL3 path: DSP synth voices, sampled instruments,
# the mix bus, and the protocol between player, render worker and stem worklet.
ts_lib(
    name = "sound",
    srcs = [
        "body_leveler.ts",
        "bus.ts",
        "dsp.ts",
        "leveler.ts",
        "measure.ts",
        "moves.ts",
        "patches/gm.ts",
        "patches/kits.ts",
        "patches/minimal_techno.ts",
        "protocol.ts",
        "sampler.ts",
        "score.ts",
        "shape.ts",
        "sound_set.ts",
        "synth.ts",
        "types.ts",
        "weight.ts",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/corpus",
        "//src/engine",
    ],
)

ts_test(
    name = "sampler_test",
    src = "sampler.test.ts",
    data = [
        "//samples:manifests",
        "//styles",
        "//styles:claudia",
        "//styles:claudia_samples",
        "//styles:samples",
    ],
    deps = [
        ":sound",
        "//src/corpus",
    ],
)

ts_test(
    name = "baseline_test",
    size = "medium",
    src = "baseline.test.ts",
    deps = [":sound"],
)

ts_test(
    name = "weight_test",
    size = "medium",
    src = "weight.test.ts",
    data = [
        "//styles",
        "//styles:samples",
    ],
    deps = [
        ":sound",
        "//src/corpus",
        "//src/engine",
    ],
)

# The worker itself, driven as the player drives it.
ts_test(
    name = "worker_test",
    size = "medium",
    src = "worker.test.ts",
    data = [
        ":worker",
        "//:node_modules/libadlmidi-js",
        "//styles",
        "//styles:claudia",
    ],
    deps = [
        ":sound",
        ":worker",
        "//src/corpus",
        "//src/engine",
    ],
)

# Two decks through the worker, as the player sends a set's slices.
ts_test(
    name = "decks_test",
    size = "medium",
    src = "decks.test.ts",
    data = [
        ":worker",
        "//:node_modules/libadlmidi-js",
        "//styles:claudia",
    ],
    deps = [
        ":sound",
        ":worker",
        "//src/corpus",
        "//src/engine",
    ],
)

ts_lib(
    name = "worker",
    srcs = [
        "stem_worklet.ts",
        "worker.ts",
    ],
    deps = [
        ":sound",
        "//:node_modules/libadlmidi-js",
        "//src/audio:events",
        "//src/audio:processor",
        "//src/corpus",
    ],
)

# Renders stems for the bus engines (module worker).
esbuild(
    name = "render_worker",
    config = {
        "banner": {"js": "if (typeof URL === 'undefined') { globalThis.URL = class URL { constructor(u) { this.href = String(u); } }; }"},
        "legalComments": "linked",
    },
    entry_point = ":worker.js",
    format = "esm",
    minify = True,
    output = "render-worker.js",
    target = "es2022",
    visibility = ["//visibility:public"],
    deps = [
        ":worker",
        "//:node_modules/libadlmidi-js",
    ],
)

# Plays the streamed stems, one output per role.
esbuild(
    name = "stem_worklet",
    entry_point = ":stem_worklet.js",
    format = "esm",
    minify = True,
    output = "stem-worklet.js",
    target = "es2022",
    visibility = ["//visibility:public"],
    deps = [":worker"],
)

ts_test(
    name = "patch_test",
    size = "medium",
    src = "patch.test.ts",
    deps = [
        ":sound",
        "//src/corpus",
    ],
)

ts_test(
    name = "patch_library_test",
    size = "medium",
    src = "patch_library.test.ts",
    data = [
        "//styles",
        "//styles:claudia",
        "//styles/minimal_techno:corpus",
    ],
    deps = [
