load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//bazel:deploy.bzl", "gh_pages_deploy")
load("//bazel:stamp.bzl", "stamp_build_info")
load("//bazel:ts.bzl", "ts_lib", "ts_test")

# DJ Claudia: an endless, seeded DJ set (//src/engine:set.ts) through the
# shared Player, with her own style pack and page. Synth and Samples only.
ts_lib(
    name = "claudia",
    srcs = ["app.ts"],
    deps = [
        ":booth",
        ":director",
        ":hud",
        "//src/app:player",
        "//src/corpus",
        "//src/engine",
        "//src/theory",
    ],
)

# The booth cam: the director's clips on two video layers, kept in time by the Player's clock.
ts_lib(
    name = "booth",
    srcs = ["booth.ts"],
    deps = [
        ":director",
        "//src/app:player",
    ],
)

# The manual arranger (arranger.html), a second page on the same set: its rules, apart from the DOM, are pure.
ts_lib(
    name = "arranger_model",
    srcs = ["arranger_model.ts"],
    deps = ["//src/engine"],
)

ts_test(
    name = "arranger_model_test",
    src = "arranger_model.test.ts",
    data = ["//styles:claudia"],
    deps = [
        ":arranger_model",
        "//src/corpus",
        "//src/engine",
    ],
)

ts_lib(
    name = "arranger",
    srcs = ["arranger.ts"],
    deps = [
        ":arranger_model",
        ":booth",
        ":director",
        "//src/app:player",
        "//src/corpus",
        "//src/engine",
        "//src/theory",
    ],
)

# The booth cam's director: which clip plays in which bars. Pure.
ts_lib(
    name = "director",
    srcs = ["director.ts"],
    visibility = ["//tools/clips:__pkg__"],
    deps = ["//src/theory"],
)

# The HUD's pure parts: the deck lanes and set names.
ts_lib(
    name = "hud",
    srcs = [
        "lanes.ts",
        "set_name.ts",
    ],
    deps = ["//src/engine"],
)

ts_test(
    name = "lanes_test",
    src = "lanes.test.ts",
    data = ["//styles:claudia"],
    deps = [
        ":hud",
        "//src/corpus",
        "//src/engine",
    ],
)

ts_test(
    name = "director_test",
    src = "director.test.ts",
    data = [
        "clips.json",
        "//styles:claudia",
    ],
    deps = [
        ":director",
        "//src/corpus",
        "//src/engine",
    ],
)

esbuild(
    name = "bundle",
    config = {
        "entryNames": "[name]",
        "legalComments": "linked",
    },
    entry_points = [":app.js"],
    format = "esm",
    minify = True,
    output_dir = True,
    sourcemap = "linked",
    target = "es2022",
    deps = [":claudia"],
)

esbuild(
    name = "arranger_bundle",
    config = {
        "entryNames": "[name]",
        "legalComments": "linked",
    },
    entry_points = [":arranger.js"],
    format = "esm",
    minify = True,
    output_dir = True,
    sourcemap = "linked",
    target = "es2022",
    deps = [":arranger"],
)

stamp_build_info(
    name = "index_html",
    src = "index.html",
    out = "stamped/index.html",
)

# What every page of hers needs. Her pack is served as styles.json and its
# samples as samples/, where the pages and the Player look for them.
SITE_FILES = glob(["clips/*"]) + [
    "apple-touch-icon.png",
    "clips.json",
    "favicon.svg",
    "social.png",
    "styles.css",
    "//src/app:fonts",
    "//src/sound:render_worker",
    "//src/sound:stem_worklet",
    "//styles:claudia",
    "//styles:claudia_samples",
]

SITE_PREFIXES = {
    "claudia.json": "styles.json",
    "claudia_samples": "samples",
}

# The complete static site.
copy_to_directory(
    name = "site",
    srcs = SITE_FILES + [
        ":bundle",
        ":index_html",
    ],
    replace_prefixes = SITE_PREFIXES,
    root_paths = [
        "src/claudia/bundle",
        "src/claudia/stamped",
        "src/claudia",
        "src/app",
        "src/sound",
        "styles",
    ],
    visibility = ["//visibility:public"],
)

# The arranger's own site, for working on a set: the same files with arranger.html as its index. Not deployed.
copy_to_directory(
    name = "arranger_site",
    srcs = SITE_FILES + [
        "arranger.css",
        "arranger.html",
        ":arranger_bundle",
    ],
    replace_prefixes = {
        "claudia.json": "styles.json",
        "claudia_samples": "samples",
        "arranger.html": "index.html",
    },
    root_paths = [
        "src/claudia/arranger_bundle",
        "src/claudia",
        "src/app",
        "src/sound",
        "styles",
    ],
)

# bazel run //src/claudia:serve  ->  http://localhost:8082
js_binary(
    name = "serve",
    args = [
        "src/claudia/site",
        "samples=styles/claudia_samples_superset",
    ],
    data = [
        ":site",
        "//styles:claudia_samples_superset",
        "//tools/serve:serve_lib",
    ],
    entry_point = "//tools/serve:serve.js",
    env = {"PORT": "8082"},
)

# bazel run //src/claudia:serve_arranger  ->  http://localhost:8083
js_binary(
    name = "serve_arranger",
    args = [
        "src/claudia/arranger_site",
        "samples=styles/claudia_samples_superset",
    ],
    data = [
        ":arranger_site",
        "//styles:claudia_samples_superset",
        "//tools/serve:serve_lib",
    ],
    entry_point = "//tools/serve:serve.js",
    env = {"PORT": "8083"},
)

# bazel run //src/claudia:deploy [-- --dry-run]
gh_pages_deploy(
    name = "deploy",
    branch = "claudia-pages",
    message = "Deploy DJ Claudia",
    site = ":site",
)
